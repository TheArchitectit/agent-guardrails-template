// Jenkins Pipeline for Team Tools
// Place this file in your repository as Jenkinsfile

pipeline {
    agent any

    environment {
        PYTHON_VERSION = '3.11'
        MCP_GO_VERSION = '1.26.11'
        CLI_GO_VERSION = '1.23.2'
        PROJECT_NAME = 'team-tools'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Teams') {
            steps {
                script {
                    // Validate team sizes
                    sh """
                        python3 scripts/team_manager.py \\
                            --project ${env.PROJECT_NAME} \\
                            validate-size
                    """

                    // Check team status
                    sh """
                        python3 scripts/team_manager.py \\
                            --project ${env.PROJECT_NAME} \\
                            status
                    """
                }
            }
        }

        stage('Test Python') {
            steps {
                script {
                    sh """
                        python3 -m pip install -r requirements.txt
                        pytest scripts/ -v --cov=scripts --cov-report=xml
                    """
                }
            }
            post {
                always {
                    publishTestResults testResultsPattern: '**/test-*.xml'
                    publishCoverage adapters: [coberturaAdapter('coverage.xml')]
                }
            }
        }

        stage('Test Go') {
            steps {
                script {
                    sh """
                        set -eu
                        export GOTOOLCHAIN=go${env.MCP_GO_VERSION}+path
                        if ! selected=\$(go env GOVERSION 2>&1); then
                            echo "Required Go ${env.MCP_GO_VERSION} unavailable: \$selected" >&2
                            exit 1
                        fi
                        [ "\$selected" = "go${env.MCP_GO_VERSION}" ] || {
                            echo "Required Go ${env.MCP_GO_VERSION}, got \$selected" >&2
                            exit 1
                        }
                        go version
                        cd mcp-server
                        go test -timeout=30m ./... -v -race
                    """
                }
            }
        }

        stage('Build CLI') {
            steps {
                script {
                    sh """
                        set -eu
                        export GOTOOLCHAIN=go${env.CLI_GO_VERSION}+path
                        if ! selected=\$(go env GOVERSION 2>&1); then
                            echo "Required Go ${env.CLI_GO_VERSION} unavailable: \$selected" >&2
                            exit 1
                        fi
                        [ "\$selected" = "go${env.CLI_GO_VERSION}" ] || {
                            echo "Required Go ${env.CLI_GO_VERSION}, got \$selected" >&2
                            exit 1
                        }
                        go version
                        cd cmd/team-cli
                        make build
                    """
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'cmd/team-cli/team', fingerprint: true
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Team validation successful!'
        }
        failure {
            echo 'Team validation failed!'
        }
    }
}
