        "mcp-server/internal/guardrails/sandbox_policy.go"
      ],
      "owner": "guardrails",
      "interface": "controlplane.component/v1",
      "trust_tier": "trusted",
      "mandatory": false,
      "signals": [
        "sandbox_executions_total"
      ],
      "rationale": "Isolation depends on host facilities (unshare/podman); optional for local, and never a host-execution path when present."
    },
    {
      "id": "audit-trail",
      "version": "1.0.0",
      "digest": "sha256:4bb84d1921506b771f0d519f4497e058b03ea933c887c61663fccb11c5af181a",
      "source_paths": [
        "mcp-server/internal/audit/logger.go"
      ],
      "owner": "guardrails",
      "interface": "controlplane.component/v1",
      "trust_tier": "trusted",
      "mandatory": false,
      "signals": [
        "audit_events_total"
      ],
      "rationale": "Durability depends on a configured store; a local deployment with no store reports reachable, not exercised, and that absence is reported rather than assumed."
    }
  ],
  "requirements": [
    {
      "id": "policy-identity",
      "description": "A decision must be attributable to a policy identity the process is actually running, so the engine must be reachable.",
      "required_components": [
        {
          "id": "policy-engine",
          "minimum_state": "reachable"
        }
      ]
    },
    {
      "id": "injection-proof",
      "description": "The mandatory detector must be reachable AND must flag a canonical injection when probed; a detector that answers safe is absent, whatever its configuration says.",
      "required_components": [
        {
          "id": "injection-detector",
          "minimum_state": "reachable"
        }
      ],
      "required_checks": [
        "canonical-injection-detected"
      ],
      "minimum_passing_checks": 1
    }
  ]
}
