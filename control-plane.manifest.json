        "mcp-server/internal/guardrails/content_filter_config.go",
        "mcp-server/internal/guardrails/content_filter_policy.go"
      ],
      "owner": "guardrails",
      "interface": "controlplane.component/v1",
      "trust_tier": "trusted",
      "depends_on": [
        "policy-engine"
      ],
      "mandatory": false,
      "signals": [
        "content_classifications_total"
      ],
      "rationale": "Semantic classification needs a model backend; absent in many deployments, so it is optional and fails closed rather than blocking the profile."
    },
    {
      "id": "sandbox-isolation",
      "version": "1.0.0",
      "digest": "sha256:0ee54124e06190b5b720e2453056588b981be20c7fef55211278c95809e07911",
