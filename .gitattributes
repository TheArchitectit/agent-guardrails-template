# Policy-pack hashes in LOCK.json are computed over raw bytes; CRLF checkout breaks them.
policy-packs/**/*.json text eol=lf

# Gitleaks fingerprints are matched line-by-line; keep the ignore list LF-only.
.gitleaksignore text eol=lf

# Bash rejects CRLF in strict-mode options; keep workflow helper scripts LF-only.
.github/scripts/*.sh text eol=lf

# Team CLI install and packaging checks run under Bash on Linux and macOS.
cmd/team-cli/*.sh text eol=lf
tests/regression/test_team_cli_backend_distribution.sh text eol=lf
tests/regression/test_optional_vision_authorization.sh text eol=lf
tests/regression/test_team_cli_output_contract.sh text eol=lf
tests/regression/test_jetbrains_bytecode_compatibility_regression_FAIL-3b71d9a2.sh text eol=lf
