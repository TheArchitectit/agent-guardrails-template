# Failure Registry - Append-only log of bugs and failures
# Format: One JSON object per line (JSONL)
# DO NOT edit existing entries - only append new ones
# Use scripts/log_failure.py to add entries consistently
#
# Schema:
#   failure_id: UUID for the failure (FAIL-xxxxxxxx)
#   timestamp: ISO 8601 timestamp
#   category: build|runtime|test|type|lint|deploy|config|regression
#   severity: low|medium|high|critical
#   error_message: The actual error message
#   root_cause: Why the failure occurred
#   affected_files: List of files involved
#   fix_commit: Git SHA of the fixing commit
#   regression_pattern: Pattern that could reintroduce this
#   prevention_rule: Specific rule to prevent recurrence
#   status: active|resolved|deprecated
#
# Example entry:
# {"failure_id": "FAIL-abc123de", "timestamp": "2026-02-07T10:00:00Z", "category": "runtime", "severity": "high", "error_message": "TypeError: Cannot read property of undefined", "root_cause": "Missing null check after JSON.parse", "affected_files": ["src/parser.js"], "fix_commit": "a1b2c3d", "regression_pattern": "JSON.parse\\(.*\\)\\.\\w+ without null check", "prevention_rule": "Always null-check parsed JSON before property access", "status": "active"}
{"failure_id":"FAIL-b7cf877c","timestamp":"2026-11-25T16:52:59.471865Z","category":"regression","severity":"medium","error_message":"GitHub Actions rejected multiline commit subjects in GITHUB_OUTPUT on PR #13","root_cause":"The bug-fix step wrote several commit subjects as a single GitHub Actions output record","status":"resolved","affected_files":[".github/workflows/regression-guard.yml"],"fix_commit":"228ebf72ecd5e748be83696784d27dae6e2cfb03","prevention_rule":"Validate the consumed numeric workflow output with mixed commit subjects","updated_at":"2026-11-25T16:52:59.566642Z","regression_test":"tests/regression/test_regression_guard_regression_FAIL_b7cf877c.py"}
{"failure_id":"FAIL-4c35b1a8","timestamp":"2026-11-25T21:29:58.563475Z","category":"runtime","severity":"high","error_message":"TypeError: Cannot read properties of undefined (reading 'enabled')","root_cause":"activate() constructs GuardrailStatusBar before initializing GuardrailClient configuration, so status rendering dereferences an undefined config before the first readiness request.","status":"resolved","affected_files":["ide/vscode-extension/src/extension.ts"],"prevention_rule":"Await GuardrailClient configuration with ExtensionContext before constructing status UI or permitting request paths; keep activation regression coverage for the first configured request.","updated_at":"2026-11-25T21:34:20.910043Z"}
{"failure_id":"FAIL-01925f50","timestamp":"2026-11-25T21:39:30.958851Z","category":"runtime","severity":"high","error_message":"Go race detector: concurrent writes to cachedRegex.lastAccess in validation CompilePattern during concurrent MatchPattern corpus validation","root_cause":"sync.Map protects map operations but not mutable cachedRegex fields; ClearRegexCache also replaces the shared map during concurrent access","status":"resolved","affected_files":["mcp-server/internal/validation/safe_regex.go","mcp-server/internal/validation/safe_regex_test.go","tests/regression/test_validation_regex_cache_regression_FAIL-01925f50.sh"],"regression_pattern":"cachedRegex|lastAccess|regexCache\\s*=\\s*sync\\.Map","prevention_rule":"Publish immutable compiled regexp values and clear concurrent caches in place; exercise simultaneous lookup and clear under Go race detection","fix_commit":"dec791dd07da9249bd8c543c27a3f3b3f9559401"}
{"failure_id":"FAIL-6a1595be","timestamp":"2026-11-25T21:58:22.616047Z","category":"config","severity":"medium","error_message":"Legacy GitLab and Jenkins Go jobs selected Go 1.21 while modules required Go 1.26.11 and 1.23.2; hosted build could depend on toolchain download or runner defaults","root_cause":"CI templates did not bind each Go job to the module directive and had no exact selected-version guard","status":"active","affected_files":["ci/gitlab-ci.yml","ci/Jenkinsfile","tests/regression/test_ci_go_toolchain_regression_FAIL_6a1595be.py"],"regression_pattern":"GO_VERSION.*1\\.21|GOTOOLCHAIN.*auto","prevention_rule":"Keep legacy Go selectors aligned to each module directive, reject missing or mismatched toolchains before build, and preserve race, coverage, and artifacts"}
